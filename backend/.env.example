# FACTSETU — Environment Variables
# Copy to .env and fill values: Copy-Item .env.example .env

# Database — PostgreSQL is preferred
# Format: postgresql+psycopg2://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/factsetu
# Fallback for local dev without Postgres (SQLite):
# DATABASE_URL=sqlite:///./factsetu.db

# App
APP_NAME=FACTSETU
APP_ENV=development
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:8765

# Gemini — required for intelligence layer
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Auth — JWT / Session
# SECRET_KEY is used as JWT fallback; set a strong random value in production
# AUTH_JWT_SECRET=change-me-auth-secret
# AUTH_JWT_EXPIRE_DAYS=7
# AUTH_COOKIE_SECURE=false  # true in production (https)
# FRONTEND_URL=http://localhost:3000

# OAuth — Google (set to enable Continue with Google)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# OAuth — X (set to enable Continue with X)
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# X_REDIRECT_URI=http://localhost:8000/api/auth/x/callback

# Data ingestion
# MAX_FETCH_BYTES, FETCH_TIMEOUT_SECONDS etc use defaults in app/core/config.py
